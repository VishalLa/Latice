        <mxCell id="lb_cls" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" value="LedgerBuilder&#xa;&#xa;__init__(gl: GeneralLedger=None, as_on: date=None)&#xa;self.gl = gl or GeneralLedger()&#xa;self.as_on = as_on or date.today()" vertex="1">
          <mxGeometry height="100" width="440" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="lb_build" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FCE3A1;strokeColor=#D6B656;fontStyle=1;" value="build(bills, opening_balances, _prebuilt_entries,&#xa; close_books_on, period_label)  [classmethod]&#xa;&#xa;1. gl = GeneralLedger()&#xa;2. if opening_balances: gl.post_entries(opening_balances)&#xa;3. tx_entries = _prebuilt_entries or&#xa;     JournalBuilder.to_journal_entries(bills)&#xa;4. gl.post_entries(tx_entries)&#xa;5. all_entries.sort(key=lambda e: e.date)&#xa;6. if close_books_on:&#xa;     closing_result = JournalBuilder().close_books(&#xa;       gl, close_books_on, period_label)&#xa;     gl.post_entries(closing_result.entries)&#xa;7. builder = cls(gl, as_on=close_books_on or today)&#xa;→ (builder, all_entries, closing_result)" vertex="1">
          <mxGeometry height="233" width="434" x="12" y="168" as="geometry" />
        </mxCell>
        <mxCell id="lb_extpost" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;" value="general_ledger_class.py&#xa;GeneralLedger.post_entries(entries)" vertex="1">
          <mxGeometry height="70" width="320" x="557" y="64" as="geometry" />
        </mxCell>
        <mxCell id="lb_extclose" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;dashed=1;" value="journal.py&#xa;JournalBuilder().close_books(gl, close_books_on, period_label)&#xa;→ ClosingResult" vertex="1">
          <mxGeometry height="90" width="320" x="635" y="238" as="geometry" />
        </mxCell>
        <mxCell id="lb_tb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" value="trial_balance()&#xa;for acc in self.gl.accounts:&#xa;  skip if no postings or balance==0&#xa;  → TrialBalanceLine(dr/cr split)&#xa;total_dr/total_cr = sum(lines)&#xa;→ TrialBalance(lines, as_on, totals)" vertex="1">
          <mxGeometry height="120" width="211" x="-93" y="484" as="geometry" />
        </mxCell>
        <mxCell id="lb_gst" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" value="gst_summary(period_label)&#xa;read Output/Input CGST/SGST/IGST/CESS&#xa;via self.gl.get(account_name)&#xa;&#xa;ITC cascade:&#xa; IGST → IGST liability → CGST → SGST&#xa; CGST → CGST liability&#xa; SGST → SGST liability&#xa;&#xa;→ GSTSummary(net payable, itc_carry_forward)" vertex="1">
          <mxGeometry height="170" width="259" x="664" y="517" as="geometry" />
        </mxCell>
        <mxCell id="lb_cb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" value="extract_cash_book()&#xa;combine Cash + Bank account postings&#xa;sorted by date, running balance&#xa;→ list[CashBookLine]" vertex="1">
          <mxGeometry height="150" width="340" x="1110" y="267" as="geometry" />
        </mxCell>
        <mxCell id="lb_ca" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" value="creditors_ageing()&#xa;for acc in gl.accounts_in_group(SUNDRY_CREDITORS):&#xa;  bucket postings by (as_on − posting.date):&#xa;   ≤30 / 31-60 / 61-90 / &gt;90&#xa;→ list[AgeingLine] sorted by balance desc" vertex="1">
