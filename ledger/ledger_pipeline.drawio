        <mxCell id="jb_close" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" value="close_books(gl: GeneralLedger, period_end, period_label)&#xa;&#xa;1. snapshot P&amp;L balances via gl.accounts_in_group(group)&#xa;2. gross_profit = sales+direct_income − purchases−direct_exp&#xa;3. Dr Sales+DirectIncome / Cr Trading A/c&#xa;4. Dr Trading A/c / Cr Purchases+DirectExp&#xa;5. transfer Gross P/L → Trading A/c ↔ P&amp;L A/c&#xa;6. Dr IndirectIncome/Cr P&amp;L A/c ; Dr P&amp;L A/c/Cr IndirectExp&#xa;7. net_profit = gross_profit + indirect_income − indirect_exp&#xa;8. transfer Net P/L → P&amp;L A/c → Capital A/c&#xa;&#xa;→ ClosingResult(entries, gross_profit, net_profit, warnings)" vertex="1">
          <mxGeometry height="222" width="365" x="40" y="860" as="geometry" />
        </mxCell>
