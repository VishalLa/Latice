          <mxGeometry height="99" width="228" x="419" y="798" as="geometry" />
        </mxCell>
        <mxCell id="le1" edge="1" parent="1" source="lb_cls" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#666666;" target="lb_build">
