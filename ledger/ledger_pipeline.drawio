          <mxGeometry height="162" width="267" x="535" y="17" as="geometry" />
        </mxCell>
        <mxCell id="ob_load" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#B8CDEC;strokeColor=#6C8EBF;fontStyle=1;" value="load_opening_balances(json_path) → (entries, period_start)&#xa;1. read + parse JSON (missing/parse errors → [], None)&#xa;2. period_start = parse_indian_date(data[&#39;period_start&#39;])&#xa;3. ob_entry = _build_opening_entry(data[&#39;opening_balances&#39;], ob_date)&#xa;4. manual_entries = [_build_manual_entry(d) for d in data[&#39;manual_entries&#39;]]&#xa;5. entries = [ob_entry] + manual_entries ; sort by date&#xa;→ (list[JournalEntry], period_start | None)" vertex="1">
